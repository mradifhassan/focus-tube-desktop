{
  "name": "focus-tube-desktop",
  "productName": "FocusTube",
  "version": "2.3.0",
  "description": "FocusTube — a free, distraction-free YouTube desktop client built for HSC students in Bangladesh. Curated educational videos from OnnoRokom Pathshala, Alchemy, and AloronXYZ. No ads, no algorithmic recommendations.",
  "main": "main.js",
  "author": "Radif Hassan <radif@example.com>",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/mradifhassan/focus-tube-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/mradifhassan/focus-tube-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/mradifhassan/focus-tube-desktop/issues"
  },
  "scripts": {
    "build:renderer": "sh scripts/build-renderer.sh",
    "start": "electron .",
    "build": "npm run build:renderer && electron-builder --linux deb --publish never",
    "build:win": "npm run build:renderer && electron-builder --win nsis --publish never",
    "build:mac": "npm run build:renderer && electron-builder --mac dmg --publish never",
    "package": "npm run build:renderer && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/browser": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.focustube.desktop",
    "productName": "FocusTube",
    "publish": {
      "provider": "github",
      "owner": "mradifhassan",
      "repo": "focus-tube-desktop",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "build/icon.png",
      "node_modules"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "synopsis": "FocusTube — distraction-free YouTube client",
      "description": "A free, distraction-free YouTube client for HSC students in Bangladesh. Browse curated educational videos from OnnoRokom Pathshala, Alchemy, and AloronXYZ — no ads, no recommendations, just focused learning.",
      "maintainer": "Radif Hassan <radif@example.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FocusTube",
      "artifactName": "FocusTube-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "deb": {
      "packageName": "focustube",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ]
    }
  }
}
